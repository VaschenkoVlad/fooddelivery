sequenceDiagram
    autonumber
    actor customer as Customer
    participant order as Order
    participant restaurant as PartnerRestaurant
    participant courier as Courier
    participant delivery as Delivery
    participant mapping as MappingService
    participant review as Review

    Note over customer: До створення Order система перевіряє кошик, доступність позицій і час доставки
    customer->>customer: Перевірити кошик і вибраний час
    alt Кошик порожній
        customer-->>customer: Відмовити в оформленні та попросити додати позицію
    else Час минув або недоступний
        customer-->>customer: Відмовити в оформленні та попросити вибрати інший час
    else Кошик і час коректні
        loop Для кожної позиції кошика
            customer->>customer: Перевірити доступність позиції
        end
        alt Є недоступна позиція
            customer-->>customer: Відмовити в оформленні та назвати недоступну позицію
        else Усі позиції доступні
            customer->>order: Order(id, customer, restaurant, requestedDeliveryTime)
            customer->>order: addItem(dishName, quantity)
            customer->>order: submit()
            order->>restaurant: confirmOrder(order)
            alt Ресторан відхиляє замовлення
                restaurant->>order: reject(reason)
                order-->>customer: Повідомити причину відхилення
            else Ресторан підтверджує замовлення
                restaurant->>order: confirm()
                order-->>restaurant: Статус Accepted
                opt Повторно надійшло підтвердження
                    restaurant->>order: confirm()
                    order-->>restaurant: Ігнорувати повтор, стан Accepted не змінюється
                end
                restaurant->>order: Подія початку приготування
                Note over restaurant,order: Після окремої події початку замовлення переходить у Preparing
                restaurant->>restaurant: markReady(order)
                opt Повторно надійшла подія готовності
                    restaurant->>restaurant: markReady(order)
                    restaurant-->>restaurant: Ігнорувати повтор, стан ReadyForPickup не змінюється
                end
                restaurant->>delivery: Delivery(id, order, mapping)
                alt Кур'єра не вдалося призначити
                    delivery-->>customer: AwaitingCourier — кур'єра ще не призначено і повідомити замовника про затримку
                    Note over delivery,customer: Замовлення залишається незавершеним і не позначається як Delivered
                else Кур'єра призначено
                    courier->>courier: acceptDelivery(delivery)
                    alt Кур'єр не може забрати замовлення
                        courier->>delivery: reportObstacle(reason)
                        delivery-->>customer: PickupFailed — замовлення не доставлено
                    else Кур'єр забирає замовлення
                        courier->>delivery: start()
                        opt Повторно надійшла подія забору
                            courier->>delivery: start()
                            delivery-->>courier: Ігнорувати повтор, стан InTransit не змінюється
                        end
                        delivery->>mapping: getRouteDetails(origin, destination)
                        Note over delivery,mapping: Маршрут імітується, зовнішнього з'єднання немає
                        mapping-->>delivery: Імітовані відомості маршруту
                        loop Оновлення перебігу доставки
                            courier->>courier: updateDeliveryStatus(status)
                            courier->>delivery: updateStatus(status)
                            delivery-->>customer: Поточний статус для відстеження
                        end
                        alt Перешкода під час доставки
                            courier->>delivery: reportObstacle(reason)
                            delivery-->>customer: Повідомити про перешкоду, статус не Delivered
                            alt Перешкоду усунуто
                                courier->>delivery: updateStatus("InTransit")
                                Note over courier,delivery: Завершення можливе лише після окремого відновлення доставки
                                courier->>delivery: complete()
                                delivery-->>customer: Delivered
                                opt Повторно надійшло завершення доставки
                                    courier->>delivery: complete()
                                    delivery-->>courier: Ігнорувати повтор, стан Delivered не змінюється
                                end
                            else Перешкоду не усунуто
                                delivery-->>customer: Залишити доставку незавершеною, не надсилати Delivered
                            end
                        else Перешкод немає
                            courier->>delivery: complete()
                            delivery-->>customer: Delivered
                            opt Повторно надійшло завершення доставки
                                courier->>delivery: complete()
                                delivery-->>courier: Ігнорувати повтор, стан Delivered не змінюється
                            end
                        end
                    end
                end
            end
        end
    end

    alt Доставку завершено (Delivered)
        customer->>customer: Перевірити оцінку 1–5 і відсутність попереднього відгуку
        alt Оцінка поза діапазоном 1–5
            customer-->>customer: Відхилити відгук і пояснити допустимий діапазон
        else Відгук для доставки вже існує
            customer-->>customer: Відхилити повторний відгук і повідомити про правило одного відгуку
        else Оцінка коректна, відгуку ще немає
            customer->>review: Review(id, customer, delivery, rating, comment)
            review-->>customer: Підтвердити прийняття відгуку
        end
    else Доставку не завершено
        customer->>customer: Відхилити відгук і пояснити, що він дозволений лише після Delivered
    end

sequenceDiagram
    autonumber
    participant main as Main
    participant customer as Customer
    participant order as Order
    participant restaurant as PartnerRestaurant
    participant courier as Courier
    participant delivery as Delivery
    participant mapping as MappingService
    participant review as Review
    participant orderStatus as OrderStatus
    participant basketItem as BasketItem

    Note over main,review: Main по черзі запускає 4 сценарії: 1 успішний, 2 порожній кошик, 3 відхилення рестораном, 4 неможливість забору
    main->>customer: Customer(id, name, address)
    main->>restaurant: PartnerRestaurant(id, name)
    opt Сценарії 1 і 4
        main->>courier: Courier(id, name, availability)
    end
    main->>order: Order(id, customer, restaurant, requestedDeliveryTime)
    opt Сценарії 1, 3 і 4
        main->>order: addItem(item)
    end
    opt Сценарій 1
        main->>order: addItem(dishName, quantity)
    end
    opt Сценарій 1
        main->>order: getItems()
        main->>basketItem: getDishName()
        main->>basketItem: getQuantity()
        main->>basketItem: getUnitPrice()
        main->>order: getRequestedDeliveryTime()
    end
    main->>customer: placeOrder(order)
    customer->>order: submit()
    Note over order: Подати можна лише непорожній кошик із часом HH:mm від 10:00 до 22:00

    alt Сценарій 2: кошик порожній
        main->>order: getStatus()
        main->>orderStatus: getDisplayName()
    else Сценарій 3: ресторан відхиляє замовлення
        main->>restaurant: rejectOrder(order, reason)
        restaurant->>order: reject(reason)
        main->>order: getStatus()
        main->>orderStatus: getDisplayName()
    else Сценарії 1 і 4: ресторан підтверджує замовлення
        main->>restaurant: confirmOrder(order)
        restaurant->>order: confirm()
        main->>restaurant: startPreparing(order)
        restaurant->>order: startPreparing()
        main->>restaurant: markReady(order)
        restaurant->>order: markReady()
        main->>mapping: MappingService()
        main->>delivery: Delivery(id, order, mappingService)
        delivery->>order: attachDelivery(delivery)
        main->>courier: acceptDelivery(delivery)
        courier->>delivery: assignCourier(courier)

        alt Сценарій 4: кур'єр не може забрати замовлення
            main->>delivery: reportObstacle(reason)
            delivery->>order: markPickupFailed()
            main->>order: getStatus()
            main->>orderStatus: getDisplayName()
        else Сценарій 1: кур'єр забирає замовлення
            main->>delivery: start()
            delivery->>order: markInTransit()
            delivery->>mapping: getRouteDetails(origin, destination)
            main->>courier: updateDeliveryStatus(status)
            courier->>delivery: updateStatus(status)
            main->>delivery: complete()
            delivery->>order: markDelivered()
            main->>customer: submitReview(delivery, rating, comment)
            customer->>review: Review(id, customer, delivery, rating, comment)
            review->>delivery: registerReview(review)
        end
    end
